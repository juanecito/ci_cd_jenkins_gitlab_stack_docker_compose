# Template for .env. Generate the real file with ./generate-env.sh, or copy this
# one to .env and fill it in. Never commit .env.
# Avoid '$' and "'" in values: Compose interpolates '$' and "'" breaks GitLab's config.

# Initial password for GitLab's root user (only read on GitLab's first start)
GITLAB_ROOT_PASSWORD=
# Password for the SonarQube Postgres database (only read on the database's first start)
SONAR_DB_PASSWORD=

# Time zone for Jenkins and GitLab Runner
TZ=UTC
# GID that owns /var/run/docker.sock on the host: stat -c %g /var/run/docker.sock
DOCKER_GID=
# Secret of the cpp-agent node, copied from Jenkins (Nodes -> cpp-agent)
CPP_AGENT_SECRET=

# Optional GitLab Runner settings (defaults shown)
# RUNNER_NAME=docker-runner
# RUNNER_TAGS=docker
# RUNNER_DEFAULT_IMAGE=alpine:latest
# RUNNER_CONCURRENT=2
# RUNNER_MOUNT_DOCKER_SOCK=false
